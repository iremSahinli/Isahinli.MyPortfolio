@model IEnumerable<MyPortfolio.Areas.Admin.Models.AdminAboutVMs.AdminAboutListVM>


!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Projects</title>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <br />
    <br />
    <br />

    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-10 col-md-12 mx-auto">
                <!-- Responsive yapı ve merkezleme -->
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title text-left mb-4">Projects</h5>

                        <div class="table-responsive">
                            <!-- Mobil uyumlu tablo -->
                            <div class="d-flex justify-content-start mb-4">
                                <a href="@Url.Action("Create", "About")" class="btn btn-success btn-xs create-btn">Create</a>
                            </div>
                            <table class="table table-hover table-bordered">
                                <thead class="thead-dark">
                                    <tr>
                                        <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Title)</th>
                                        <th>@Html.DisplayNameFor(model => model.FirstOrDefault().SubDescription)</th>
                                        <th>@Html.DisplayNameFor(model => model.FirstOrDefault().MyPhoto)</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@Html.DisplayFor(itemModel => item.Title)</td>
                                            <td>@Html.DisplayFor(itemModel => item.SubDescription)</td>
                                            <td>
                                                @if (item.MyPhoto != null)
                                                {
                                                    var base64Image = "data:image/*;base64," + Convert.ToBase64String(item.MyPhoto);
                                                    <img src="@base64Image" alt="My Photo" style="max-width: 100px; max-height: 100px; object-fit: cover; display: block; margin: 0 auto;" />
                                                }
                                                else
                                                {
                                                    <span>No Photo</span>
                                                }
                                            </td>
                                            <td class="action-buttons">
                                                <a href="@Url.Action("Update", "About", new { id = item.AboutId })" class="btn btn-warning btn-sm update-btn">Update</a>
                                                <a href="@Url.Action("Delete", "About", new { id = item.AboutId })" class="btn btn-danger btn-sm delete-btn">Delete</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>
</html>
<style>

</style>
