@model IEnumerable<MyPortfolio.Areas.Admin.Models.AdminProjectVMs.AdminProjectListVM>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Projects</title>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <br />
    <br />
    <br />

    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-10 col-md-12 mx-auto">
                <!-- Responsive yapı ve merkezleme -->
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title text-left mb-4">Projects</h5>

                        <div class="table-responsive">
                            <!-- Mobil uyumlu tablo -->
                            <div class="d-flex justify-content-end mb-4">
                                <a href="@Url.Action("Create", "Project")" class="btn btn-success btn-sm create-btn">Create</a>
                            </div>
                            <table class="table table-hover table-bordered">
                                <thead class="thead-dark">
                                    <tr>
                                        <th>@Html.DisplayNameFor(model => model.FirstOrDefault().ProjectId)</th>
                                        <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Title)</th>
                                        <th>@Html.DisplayNameFor(model => model.FirstOrDefault().SubTitle)</th>
                                        <th class="desc-column">@Html.DisplayNameFor(model => model.FirstOrDefault().ProjectDescription)</th>
                                        <th>@Html.DisplayNameFor(model => model.FirstOrDefault().ProjectUrl)</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@Html.DisplayFor(itemModel => item.ProjectId)</td>
                                            <td>@Html.DisplayFor(itemModel => item.Title)</td>
                                            <td>@Html.DisplayFor(itemModel => item.SubTitle)</td>
                                            <td class="desc-column">@Html.DisplayFor(itemModel => item.ProjectDescription)</td>
                                            <td>@Html.DisplayFor(itemModel => item.ProjectUrl)</td>
                                            <td class="action-buttons">
                                                <a href="@Url.Action("Update", "Project", new { id = item.ProjectId })" class="btn btn-warning btn-sm update-btn">Update</a>
                                                <a href="@Url.Action("Delete", "Project", new { id = item.ProjectId })" class="btn btn-danger btn-sm delete-btn">Delete</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>
</html>

<style>
    /* Tablo ve kartın genişlemesini sağlayan yapı */
    .container-fluid {
        max-width: 90%;
    }

    .table-responsive {
        width: 100%;
    }

    /* Butonları düzenleme */
    .action-buttons {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        justify-content: center;
    }

    .create-btn, .update-btn, .delete-btn {
        flex: 1;
        text-align: center;
        padding: 5px 10px; /* İç boşluk */
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        transition: box-shadow 0.3s ease-in-out, background-color 0.3s ease-in-out;
    }

    /* Create Butonu */
    .create-btn {
        box-shadow: 0 4px 8px rgba(0, 255, 0, 0.5);
    }

        .create-btn:hover {
            animation: blink-create 0.5s infinite alternate;
        }

    /* Update Butonu */
    .update-btn {
        box-shadow: 0 4px 8px rgba(255, 165, 0, 0.8);
    }

        .update-btn:hover {
            animation: blink-update 0.5s infinite alternate;
        }

    /* Delete Butonu */
    .delete-btn {
        box-shadow: 0 4px 8px rgba(255, 0, 0, 0.5);
    }

        .delete-btn:hover {
            animation: blink-delete 0.8s infinite alternate;
        }

    /* Animasyonlar */
    @@keyframes blink-create {
        0% {
            background-color: green;
            box-shadow: 0 4px 12px rgba(0, 255, 0, 0.8);
        }

        100% {
            background-color: darkgreen;
            box-shadow: 0 4px 16px rgba(0, 255, 0, 1);
        }
    }

    @@keyframes blink-update {
        0% {
            background-color: orange;
            box-shadow: 0 4px 12px rgba(255, 165, 0, 0.8);
        }

        100% {
            background-color: darkorange;
            box-shadow: 0 4px 16px rgba(255, 165, 0, 1);
        }
    }

    @@keyframes blink-delete {
        0% {
            background-color: red;
            box-shadow: 0 4px 12px rgba(255, 0, 0, 0.8);
        }

        100% {
            background-color: darkred;
            box-shadow: 0 4px 16px rgba(255, 0, 0, 1);
        }
    }
</style>
