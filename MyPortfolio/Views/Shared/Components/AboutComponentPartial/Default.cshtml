@model MyPortfolio.DAL.Entities.About
@{
    string base64Image = Model.MyPhoto != null
        ? "data:image/*;base64," + Convert.ToBase64String(Model.MyPhoto)
        : "";
}

<!-- about section -->
<section class="section pt-0" id="about">
    <!-- container -->
    <div class="container text-center">
        <!-- about wrapper -->
        <div class="about">
            <div class="about-img-holder">
                <img src="@base64Image" class="about-img"
                     alt="Profile img.">
            </div>
            <div class="about-caption">
                <p class="section-subtitle"><strong>@Model.Title</strong></p>
                <h5 class="section-title mb-3">Full-Stack .NET Developer</h5>
                <p>@Model.SubDescription</p>
                <div class="social-links-container">
                    <button class="btn-rounded btn btn-outline-dark mt-4">
                        Download CV
                    </button>
                    <a href="https://github.com/iremSahinli"
                       target="_blank"
                       class="text-success text-decoration-none d-inline-flex align-items-center">
                        <img src="/meyawo-1.0.0/assets/imgs/github-logo-60.png"
                             alt="github"
                             width="44"
                             height="44"
                             class="me-2" />
                    </a>
                    <a href="https://www.linkedin.com/in/oğuz-irem-şahinli-b66a3b274/"
                       target="_blank"
                       class="text-success text-decoration-none d-inline-flex align-items-center">
                        <img src="/meyawo-1.0.0/assets/imgs/linkedin-square-logo-48.png"
                             alt="LinkedIn"
                             width="44"
                             height="44"
                             class="me-2" />
                    </a>
                    <a href="https://medium.com/@@sahinliirem34"
                       target="_blank"
                       class="text-success text-decoration-none d-inline-flex align-items-center">
                        <img src="~/meyawo-1.0.0/assets/imgs/medium-square-logo-48.png"
                             alt="Medium"
                             width="43"
                             height="44"
                             class="me-2" />
                    </a>
                </div>
            </div>
        </div>
        <!-- end of about wrapper -->
    </div>
    <!-- end of container -->
</section>
