@model IEnumerable<MyPortfolio.Areas.Admin.Models.AdminSkillVMs.AdminSkillListVM>


@if (Model != null)
{
    var backendSkills = Model.Where(s => s.SkillDescription == "Backend").ToList();
    var frontendSkills = Model.Where(s => s.SkillDescription == "Frontend").ToList();

    <!-- pricing section -->
    <section class="section" id="pricing">
        <div class="container text-center">
            <h6 class="section-title mb-5">Kullandığım Teknolojiler</h6>
            <!-- row -->
            <div class="pricing-wrapper">
                <div class="pricing-card">
                    <div class="pricing-card-header">
                        <img class="pricing-card-icon" src="/meyawo-1.0.0/assets/imgs/Tecnology.png"
                             alt="Backend Teknolojileri">
                    </div>
                    <div class="pricing-card-body">
                        <h6 class="pricing-card-title">Backend</h6>
                        <div class="pricing-card-list">
                            @foreach (var skill in backendSkills)
                            {
                                <p>@skill.Title</p>
                            }
                        </div>
                    </div>
                </div>
                <div class="pricing-card">
                    <div class="pricing-card-header">
                        <img class="pricing-card-icon" src="/meyawo-1.0.0/assets/imgs/Tecnology.png"
                             alt="Frontend Teknolojileri">
                    </div>
                    <div class="pricing-card-body">
                        <h6 class="pricing-card-title">Frontend</h6>
                        <div class="pricing-card-list">
                            @foreach (var skill in frontendSkills)
                            {
                                <p>@skill.Title</p>
                            }
                        </div>
                    </div>


            </div><!-- end of pricing wrapper -->
        </div> <!-- end of container -->
    </section>
}
else
{
    
}